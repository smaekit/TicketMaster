{
  "name": "@ticketmaster/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:test": "bun --env-file=.env.test src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun src/lib/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.60",
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@ticketmaster/shared": "workspace:*",
    "@types/multer": "^2.1.0",
    "ai": "^6.0.175",
    "better-auth": "^1.6.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "form-data": "^4.0.5",
    "mailgun.js": "^13.0.1",
    "mailparser": "^3.9.8",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "pg-boss": "^12.18.2",
    "resend": "^6.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
